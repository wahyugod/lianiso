def pangkat(a, b):
    if b == 0:
        return 1
    elif b < 0:
        return 1 / pangkat(a, -b)
    else:
        return a * pangkat(a, b - 1)

a = int(input("Masukkan bilangan: "))
b = int(input("Masukkan pangkat: "))

print(f"Hasil {a}^{b} adalah {pangkat(a, b)}")
